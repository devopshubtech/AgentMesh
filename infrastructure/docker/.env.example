# Copy to .env (scripts/dev-setup does this and fills in secrets).
# Host ports — chosen to avoid 80/3000/5432/6000 already used on the dev machine.
AM_PG_PORT=15432
AM_NATS_PORT=14222
AM_NATS_MON_PORT=18222
AM_API_PORT=18080
AM_GATEWAY_PORT=18443
AM_DASHBOARD_PORT=13000

AM_PUBLIC_GATEWAY_URL=https://localhost:18443
AM_LOG_LEVEL=info

AM_PG_PASSWORD=change-me
AM_ADMIN_EMAIL=admin@agentmesh.local
AM_ADMIN_PASSWORD=change-me-please

# Optional: enrollment token for the demo Linux agent container.
AM_DEMO_ENROLL_TOKEN=
